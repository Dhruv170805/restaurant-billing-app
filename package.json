    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
