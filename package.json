    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "libphonenumber-js": "^1.12.41",
    "lucide-react": "^0.575.0",
    "minio": "^8.0.7",
    "mongodb": "^7.1.0",
    "next": "^16.1.6",
    "node-vibrant": "^4.0.4",
    "nodemailer": "^8.0.5",
    "otpauth": "^9.5.0",
    "passport": "^0.7.0",
