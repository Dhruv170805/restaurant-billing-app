{
  "name": "restaurant-billing-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "dev:worker": "ts-node -r tsconfig-paths/register -P tsconfig.node.json worker.ts",
    "dev:hq": "ts-node -r tsconfig-paths/register -P tsconfig.node.json src/main.ts",
    "dev:all": "concurrently \"node server.js\" \"ts-node -r tsconfig-paths/register -P tsconfig.node.json worker.ts\" \"ts-node -r tsconfig-paths/register -P tsconfig.node.json src/main.ts\"",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "start:worker": "NODE_ENV=production node worker.js",
    "migrate": "node --env-file=.env.local scripts/migrate-to-multitenant.mjs",
    "lint": "eslint",
    "test": "jest"
  },
